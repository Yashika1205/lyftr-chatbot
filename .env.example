# ---------------- Backend ----------------
# Key pool, comma-separated, at least 2. Ids are key_1, key_2, ... in this order.
LLM_API_KEYS=your-first-gemini-api-key,your-second-gemini-api-key
# LiteLLM model used by every key (any LiteLLM model string works).
LLM_MODEL=gemini/gemini-3.5-flash-lite
# Optional: one model per key, same order as LLM_API_KEYS (spread the pool across models).
# LLM_KEY_MODELS=gemini/gemini-3.5-flash-lite,gemini/gemini-3.1-flash-lite
# Backup models tried on the same key if its model is retired, overloaded or out of quota ("" disables).
# LLM_FALLBACK_MODELS=gemini/gemini-3.5-flash-lite,gemini/gemini-3.1-flash-lite,gemini/gemini-3.6-flash,gemini/gemini-3.8-flash
# SQLite file. In Docker this lives on the named volume mounted at /data.
DATABASE_URL=sqlite:////data/app.db
# Comma-separated CORS origins allowed to call the API (your frontend URL(s)).
ALLOWED_ORIGINS=http://localhost:3000
# true enables the X-Simulate-Failure test header on POST /chat.
ENABLE_FAILURE_SIMULATION=true
# Optional tuning
DEFAULT_SYSTEM_PROMPT=You are a helpful, concise assistant. Answer clearly and accurately.
CACHE_TYPE=disk
CACHE_DIR=/data/llm_cache
CACHE_TTL_SECONDS=604800
LLM_TIMEOUT_SECONDS=15
MAX_HISTORY_MESSAGES=40
# true = offline deterministic replies (no API calls). For tests/demos without keys only.
MOCK_LLM=false

# ---------------- Frontend ----------------
# Backend URL the browser calls. Docker: read at container start. Vercel/Netlify: set VITE_API_BASE_URL at build.
FRONTEND_API_BASE_URL=http://localhost:8000
VITE_API_BASE_URL=http://localhost:8000
